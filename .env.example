# Non-secret WebUI deployment settings only. Configure credentials in Hermes itself.
HERMES_DASHBOARD_URL=http://host.docker.internal:9119
PUBLIC_ORIGIN=https://localhost:8787
WEBUI_PORT=8787

# Run bash scripts/setup-https.sh HOST PORT before Compose.
# It retains the existing upstream settings and records key ownership here.
WEBUI_TLS_DIR=./.local/tls/server
