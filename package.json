{
  "name": "hermes-webui-ng",
  "version": "0.0.1",
  "description": "Hermes-native standalone WebUI — Phase 0 protocol spike",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node build/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint server src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test build/tests/unit/*.test.js",
    "test:contract": "node --test build/tests/contract/*.test.js",
    "test:e2e:critical": "playwright test",
    "test:live": "node build/tests/integration/live.js",
    "dev:fixture": "node scripts/dev-fixture.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "ws": "8.21.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  }
}
